{
  "name": "@vooksio/monorepo",
  "version": "1.0.0",
  "private": true,

  "scripts": {
    "dev": "nx serve web",
    "dev:mobile": "nx serve mobile", 
    "dev:backend": "nx serve backend",
    "build": "nx run-many --target=build --all",
    "build:all": "pnpm build:web && pnpm build:backend",
    "build:web": "nx build web",
    "build:backend": "nx build backend",
    "test": "nx run-many --target=test --all",
    "test:web": "nx test web",
    "lint": "nx run-many --target=lint --all",
    "lint:web": "nx lint web",
    "format": "prettier --write .",
    "graph": "nx graph",
    "deploy:web": "vercel --prod",
    "deploy:backend": "vercel --cwd apps/backend --prod",
    "deploy:mobile": "cd apps/mobile && eas build --platform all"
  },
  "license": "MIT",
  "devDependencies": {
    "@swc/cli": "~0.6.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "prettier": "^2.6.2",
    "vitest": "^3.0.0"
  },
  "nx": {},
  "dependencies": {
    "nx": "21.3.11",
    "@nx/vite": "21.3.11",
    "@nx/web": "21.3.11",
    "@nx/react": "21.3.11",
    "@nx/react-native": "21.3.11",
    "@nx/js": "21.3.11",
    "@nx/eslint": "21.3.11",
    "@nx/eslint-plugin": "21.3.11",
    "@nx/node": "21.3.11",
    "@vitejs/plugin-react": "^4.2.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@swc-node/register": "~1.9.1",
    "vite": "^6.0.0",
    "tslib": "^2.3.0",
    "typescript": "~5.8.2",
    "@eslint/js": "^9.8.0",
    "eslint": "^9.8.0",
    "typescript-eslint": "^8.29.0"
  },
  "engines": {
    "node": "22.x",
    "pnpm": ">=8.0.0"
  }
}
